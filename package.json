{
  "name": "mini-key",
  "version": "0.1.0",
  "description": "Configurator for SIKAI / 1189:884x programmable mini keyboards",
  "main": "./out/main/index.js",
  "author": {
    "name": "Renan Garcia Borges",
    "email": "renangarciaborges@icloud.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:mac": "electron-vite build && electron-builder --mac --dir",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "dev.minikey.app",
    "productName": "Mini Key",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.utilities",
      "x64ArchFiles": "**/node_modules/node-hid/prebuilds/**",
      "artifactName": "Mini-Key-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mini-Key-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Renan Garcia Borges <renangarciaborges@icloud.com>",
      "artifactName": "Mini-Key-linux-amd64.${ext}"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.sh"
    }
  },
  "dependencies": {
    "node-hid": "^3.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "homepage": "https://github.com/renanborgez/sikai-macos-mini-keyboard-configurator"
}
